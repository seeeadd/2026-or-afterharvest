{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/community-boost/nms-2027/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=604800" }]
    },
    {
      "source": "/community-boost/nms-2027/site.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/community-boost/nms-2027/site.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    {
      "source": "/((?!ana-calin/workshop/|api/).*)",
      "has": [{ "type": "host", "value": "exitplan.howwegrowtoday.com" }],
      "destination": "/ana-calin/workshop/",
      "permanent": false
    }
  ]
}
